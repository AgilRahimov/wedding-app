{
  "name": "wedding-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "backup": "mkdir -p backups && cp prisma/dev.db backups/dev-$(date +%Y-%m-%d-%H%M).db && ( mkdir -p \"$HOME/Documents/Wed/wedding-backups\" && cp prisma/dev.db \"$HOME/Documents/Wed/wedding-backups/dev-$(date +%Y-%m-%d-%H%M).db\" && echo 'Backed up locally and to iCloud.' ) || echo 'Backed up locally. (iCloud copy skipped \u2014 no permission.)'",
    "test": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.8",
    "next": "16.3.0",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
